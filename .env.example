# 服务端环境变量示例。复制为 .env 后按需修改。
# 重要：WX_APPSECRET 只能放在服务端，绝不能写进 miniprogram/ 目录。

# ---- 服务 ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# 对外可访问的地址，用于预览页链接与 CSV 文件名。生产请填 https 域名。
PUBLIC_BASE_URL=http://localhost:3000

# 会话 token 的签名密钥。生产环境必填，至少 16 位。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
TOKEN_TTL_SECONDS=2592000

# ---- 数据存储 ----
# 相对项目根目录的 SQLite 文件路径
DATABASE_FILE=data/app.db
DATA_DIR=data

# ---- 微信小程序（可选：不配置也能本地跑通）----
WX_APPID=
WX_APPSECRET=
# 小程序码打开的页面路径，必须与 miniprogram/app.json 中的页面一致
WX_ORG_PAGE=pages/org-home/index
WX_PROJECT_PAGE=pages/project-detail/index
# release / trial / develop
WX_ENV_VERSION=release

# ---- 开发辅助 ----
# 允许 /api/auth/dev-login（NODE_ENV=production 时强制关闭）
AUTH_DEV_MODE=true
# 开发预览页的访问令牌
PREVIEW_TOKEN=dev-preview
# 是否允许在缺少微信凭据时降级为“开发预览码”。生产环境强制为否。
QR_ALLOW_PREVIEW=true

# ---- 限制 ----
MAX_ANSWER_BYTES=65536
MAX_EXPORT_ROWS=20000
