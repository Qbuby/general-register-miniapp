{
  "name": "general-register-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "通用机构招生报名小程序 —— 一个统一的小程序服务多家机构，支持机构主页、项目发布、动态报名表、二维码推广与报名管理",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "serve": "node dist/index.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:miniapp": "node scripts/check-miniprogram.mjs",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "verify": "npm run typecheck && npm run check:miniapp && npm test",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
