.field {
  margin-bottom: 28rpx;
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.req {
  color: #d4380d;
  margin-left: 4rpx;
}

.input {
  border: 1rpx solid #e3e6ea;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background: #fff;
}

.textarea {
  border: 1rpx solid #e3e6ea;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background: #fff;
  min-height: 140rpx;
  width: 100%;
}

.ph {
  color: #b6bcc4;
}

.picker {
  color: #1c1f23;
}

.hint {
  color: #8a9099;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.error {
  color: #d4380d;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.options {
  display: flex;
  flex-wrap: wrap;
}

.option {
  padding: 14rpx 24rpx;
  border: 1rpx solid #e3e6ea;
  border-radius: 8rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  background: #fff;
  display: flex;
  align-items: center;
}

.option-active {
  border-color: #2b62d9;
  color: #2b62d9;
  background: #f2f6ff;
}
