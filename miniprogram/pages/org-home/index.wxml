<view wx:if="{{loading}}" class="state">加载中…</view>

<view wx:elif="{{error}}" class="state state-error">
  <view>{{error}}</view>
  <view class="btn btn-plain state-btn" bindtap="onLoad">重新加载</view>
</view>

<block wx:elif="{{organization}}">
  <view class="hero">
    <image wx:if="{{organization.coverUrl}}" class="cover" src="{{organization.coverUrl}}" mode="aspectFill" />
    <view class="hero-body">
      <image wx:if="{{organization.logoUrl}}" class="logo" src="{{organization.logoUrl}}" mode="aspectFill" />
      <view class="name">{{organization.name}}</view>
      <view wx:if="{{organization.address}}" class="muted">{{organization.address}}</view>
    </view>
  </view>

  <view wx:if="{{organization.intro}}" class="card">
    <view class="section-title">机构介绍</view>
    <view class="muted intro">{{organization.intro}}</view>
  </view>

  <view class="card">
    <view class="section-title">在招项目（{{projects.length}}）</view>
    <view wx:if="{{projects.length === 0}}" class="muted">该机构暂未发布招生项目。</view>

    <view
      wx:for="{{projects}}"
      wx:key="id"
      class="project"
      data-code="{{item.shareCode}}"
      bindtap="onTapProject"
    >
      <image wx:if="{{item.coverUrl}}" class="project-cover" src="{{item.coverUrl}}" mode="aspectFill" />
      <view class="project-body">
        <view class="project-title">{{item.title}}</view>
        <view class="muted">{{item.summary || '暂无简介'}}</view>
        <view class="project-tags">
          <text class="tag">{{item.typeLabel}}</text>
          <text class="tag {{item.canSubmit ? 'tag-ok' : 'tag-warn'}}">{{item.signupLabel}}</text>
        </view>
        <view class="muted project-time" wx:if="{{item.startText}}">开课时间：{{item.startText}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">联系方式</view>
    <view class="row"><text class="muted">联系人</text><text>{{organization.contactName || '—'}}</text></view>
    <view class="row"><text class="muted">联系电话</text><text>{{organization.contactPhone || '—'}}</text></view>
    <view class="row"><text class="muted">微信号</text><text>{{organization.wechatId || '—'}}</text></view>
    <view class="btn btn-plain contact-btn" bindtap="copyContact">复制联系方式</view>
  </view>

  <view class="mine-entry" bindtap="onGoMine">我是机构管理员？点这里进入工作台 ›</view>
</block>
