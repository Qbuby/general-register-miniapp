.state {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #8a9099;
}

.state-error {
  color: #d4380d;
}

.state-btn {
  margin-top: 24rpx;
  display: inline-block;
  padding: 16rpx 40rpx;
}

.hero {
  background: #fff;
}

.cover {
  width: 100%;
  height: 320rpx;
  display: block;
}

.hero-body {
  padding: 24rpx;
  text-align: center;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-bottom: 12rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.intro {
  white-space: pre-wrap;
}

.project {
  border-top: 1rpx solid #f0f1f3;
  padding: 20rpx 0;
  display: flex;
}

.project:first-of-type {
  border-top: none;
}

.project-cover {
  width: 180rpx;
  height: 140rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
  background: #f2f3f5;
}

.project-body {
  flex: 1;
  min-width: 0;
}

.project-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.project-tags {
  margin-top: 10rpx;
}

.project-time {
  margin-top: 8rpx;
}

.contact-btn {
  margin-top: 24rpx;
}

.mine-entry {
  text-align: center;
  color: #6b7280;
  font-size: 24rpx;
  padding: 30rpx;
}
