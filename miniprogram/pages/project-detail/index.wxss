.state {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #8a9099;
}

.state-error {
  color: #d4380d;
}

.state-btn {
  margin-top: 24rpx;
  display: inline-block;
  padding: 16rpx 40rpx;
}

.cover {
  width: 100%;
  height: 360rpx;
  display: block;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tags {
  margin-bottom: 12rpx;
}

.summary,
.detail {
  white-space: pre-wrap;
}

.contact-btn {
  margin-top: 24rpx;
}

.footer {
  padding: 20rpx 24rpx 60rpx;
}

.footer .btn {
  padding: 26rpx;
}

.tip {
  text-align: center;
  color: #8a9099;
  font-size: 22rpx;
  margin-top: 12rpx;
}
