<view class="toolbar">
  <input
    class="search"
    value="{{query}}"
    placeholder="搜索姓名或联系方式"
    confirm-type="search"
    bindinput="onSearchInput"
    bindconfirm="onSearch"
  />
  <view class="search-btn" bindtap="onSearch">搜索</view>
  <view wx:if="{{query}}" class="search-btn" bindtap="onClearSearch">清除</view>
</view>

<scroll-view class="filters" scroll-x="true">
  <view
    wx:for="{{statusFilters}}"
    wx:key="value"
    class="filter {{statusFilter === item.value ? 'filter-active' : ''}}"
    data-value="{{item.value}}"
    bindtap="onFilterStatus"
  >{{item.label}}</view>
</scroll-view>

<view class="summary">
  <text>共 {{total}} 条报名</text>
  <text class="export" bindtap="onExport">导出 CSV</text>
</view>

<view wx:if="{{loading}}" class="state">加载中…</view>

<view wx:elif="{{error}}" class="state state-error">
  <view>{{error}}</view>
  <view class="btn btn-plain state-btn" bindtap="onRetry">重新加载</view>
</view>

<view wx:elif="{{rows.length === 0}}" class="state">暂无报名记录</view>

<view wx:else>
  <view wx:for="{{rows}}" wx:key="id" class="card reg" data-index="{{index}}" bindtap="onTapRow">
    <view class="reg-head">
      <view class="reg-name">{{item.contactName || '（未填写姓名）'}}</view>
      <view class="tag {{item.status === 'pending' ? '' : (item.status === 'rejected' ? 'tag-warn' : 'tag-ok')}}">{{item.statusLabel}}</view>
    </view>

    <view class="muted" wx:if="{{!projectId}}">项目：{{item.projectTitle}}</view>
    <view class="reg-phone" data-phone="{{item.contactPhone}}" catchtap="onCopyPhone">{{item.contactPhone || '（无联系方式）'}} · 点击复制</view>
    <view class="muted">{{item.createdText}} · 编号 {{item.receiptCode}}</view>
    <view wx:if="{{item.answerText}}" class="muted answer">{{item.answerText}}</view>

    <view class="actions">
      <view
        wx:if="{{item.status !== 'pending'}}"
        class="action"
        data-index="{{index}}"
        data-status="pending"
        bindtap="onSetStatus"
      >标为待处理</view>
      <view
        wx:if="{{item.status !== 'contacted'}}"
        class="action"
        data-index="{{index}}"
        data-status="contacted"
        bindtap="onSetStatus"
      >标为已联系</view>
      <view
        wx:if="{{item.status !== 'confirmed'}}"
        class="action"
        data-index="{{index}}"
        data-status="confirmed"
        bindtap="onSetStatus"
      >标为已确认</view>
      <view
        wx:if="{{item.status !== 'rejected'}}"
        class="action action-danger"
        data-index="{{index}}"
        data-status="rejected"
        bindtap="onSetStatus"
      >放弃</view>
    </view>
  </view>

  <view wx:if="{{loadingMore}}" class="state">加载中…</view>
  <view wx:elif="{{rows.length >= total}}" class="state">没有更多了</view>
</view>
