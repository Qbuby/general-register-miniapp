<view wx:if="{{loading}}" class="state">加载中…</view>

<view wx:elif="{{error}}" class="state state-error">
  <view>{{error}}</view>
  <view class="btn btn-plain state-btn" bindtap="onRetry">重新加载</view>
</view>

<block wx:else>
  <view wx:if="{{organization.status !== 'published'}}" class="notice">
    机构当前状态：{{organization.status === 'hidden' ? '仅链接可见（不出现在公开列表）' : '未发布（公众无法访问主页）'}}。
    在「机构资料」中改为「已发布」后，扫码才能正常打开。
  </view>

  <view class="card header">
    <view class="header-main">
      <view class="org-name">{{organization.name}}</view>
      <view class="muted">点击右侧编辑资料</view>
    </view>
    <view class="edit-link" bindtap="onEditOrg">编辑</view>
  </view>

  <view class="stat-row">
    <view class="stat">
      <view class="stat-num">{{stats.registrationCount}}</view>
      <view class="muted">总报名</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{stats.pendingCount}}</view>
      <view class="muted">待处理</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{stats.projectCount}}</view>
      <view class="muted">项目</view>
    </view>
  </view>

  <view class="card qr-entry" bindtap="onShowQr">
    <view>
      <view class="section-title">机构主页二维码</view>
      <view class="muted">查看、保存并下载，打印到宣传单上</view>
    </view>
    <view class="arrow">›</view>
  </view>

  <view class="card qr-entry" bindtap="onManageMembers">
    <view>
      <view class="section-title">成员管理</view>
      <view class="muted">邀请同事加入，分配管理员或运营角色</view>
    </view>
    <view class="arrow">›</view>
  </view>

  <view class="card">
    <view class="section-title">我的项目（{{projects.length}}）</view>
    <view wx:if="{{projects.length === 0}}" class="muted">还没有项目，点击下方按钮创建第一个招生项目。</view>

    <view wx:for="{{projects}}" wx:key="id" class="project">
      <view class="project-head" data-id="{{item.id}}" bindtap="onEditProject">
        <view class="project-title">{{item.title}}</view>
        <view class="tags">
          <text class="tag">{{item.typeLabel}}</text>
          <text class="tag {{item.status === 'published' ? 'tag-ok' : 'tag-warn'}}">{{item.statusLabel}}</text>
          <text class="tag">{{item.signupLabel}}</text>
        </view>
      </view>

      <view class="project-meta muted">
        <view wx:if="{{item.startText}}">活动时间：{{item.startText}}</view>
        <view wx:if="{{item.signupEndText}}">报名截止：{{item.signupEndText}}</view>
        <view>名额：{{item.capacity == null ? '不限' : item.registered_count + ' / ' + item.capacity}}</view>
      </view>

      <view class="project-actions">
        <view class="action" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="onViewRegistrations">报名记录</view>
        <view class="action" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="onProjectQr">项目码</view>
        <view class="action" data-id="{{item.id}}" bindtap="onEditProject">编辑</view>
      </view>
    </view>

    <view class="btn create-btn" bindtap="onCreateProject">+ 新建招生项目</view>
  </view>
</block>
